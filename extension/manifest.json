{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "3.0.0",
  "minimum_chrome_version": "116",
  "description": "__MSG_extDesc__",
  "default_locale": "en",
  "permissions": [
    "downloads",
    "contextMenus",
    "storage",
    "notifications",
    "alarms",
    "webRequest",
    "cookies",
    "tabs",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "externally_connectable": {
    "ids": [
      "*"
    ],
    "matches": [
      "http://*/*",
      "https://*/*"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "commands": {
    "toggle-capture": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "__MSG_cmdToggle__"
    },
    "open-panel": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "__MSG_cmdOpenPanel__"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "lib.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "short_name": "__MSG_extShortName__"
}
